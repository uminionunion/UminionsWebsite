FROM wordpress:php8.2-apache

RUN a2enmod rewrite proxy proxy_http proxy_wstunnel
COPY ./apache-pantry-proxy.conf /etc/apache2/conf-available/pantry-proxy.conf
COPY ./apache-uhub-proxy.conf /etc/apache2/conf-available/uhub-proxy.conf
RUN a2enconf pantry-proxy uhub-proxy
COPY ./local-preview/db.Conn.Ver01.php /app/includes/db.Conn.Ver01.php
COPY ./wp-content/themes/astra-child /opt/uminion-preview/wp-content/themes/astra-child
COPY ./includes/uhub/dist /opt/uminion-preview/uhub/dist
COPY ./includes/pantry-finder/dist /opt/uminion-preview/pantry-finder/dist
COPY ./includes/uhub/public/EmojisForUminionWebsite /opt/uminion-preview/EmojisForUminionWebsite
COPY ./includes/uhub/public/defaultUminionUassets /opt/uminion-preview/defaultUminionUassets
COPY ./local-preview/start-wordpress.sh /usr/local/bin/start-preview-wordpress
RUN sed -i 's/\r$//' /usr/local/bin/start-preview-wordpress \
    && chmod +x /usr/local/bin/start-preview-wordpress
ENTRYPOINT ["start-preview-wordpress"]
CMD ["apache2-foreground"]
